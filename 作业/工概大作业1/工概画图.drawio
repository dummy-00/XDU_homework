        </mxCell>
        <mxCell id="yK7C81_LoDnKHuH5_ecm-7" value="kl散度开始收敛时，认为是theta、梯度值最好的点，神经网络输出theta、梯度值" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="200" width="120" height="60" as="geometry" />
